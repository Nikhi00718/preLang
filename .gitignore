# CMake build folder
build/
build-*/

# CSV files written by the unit tests when run from the project folder
test_*.csv
test_imageset_*
test_tableset_*
test_certificate_*
test_private_*

# Files written by running the examples (only the students.prep outputs are kept)
output/*
!output/generated.py
!output/clean.csv
!output/preplang_manifest.json

# Evaluation data and results that are regenerated
eval/data/
eval/work/

# Python bytecode
__pycache__/

# The demo: generated working folders
demo/work/

# The folder for the hand-typed demo (py -3 demo/run_demo.py stage)
demo/live/
eval/.venv-baselines/
eval/.venv-dp/
eval/.venv-hdmm/

# LaTeX build files of the paper
paper/*.aux
paper/*.log
paper/*.out
paper/build_log.txt

# Lean build output
proofs/.lake/

# pdflatex output; the committed copy is paper/PrepLang_Software_SCP.pdf
paper/preplang.pdf
paper/preplang-scp.pdf
paper/*.spl
# written by paper/make_scp_submission.py
paper/scp-submission/
paper/scp-osp-submission/
paper/preplang-osp.pdf
