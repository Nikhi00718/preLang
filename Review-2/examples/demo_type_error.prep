# Deliberate SEMANTIC and TYPE errors.
# Each statement below is syntactically perfect -- only the
# schema-aware semantic analyser can reject them.

LOAD "students.csv" AS students;

NORMALIZE students.name;              # TYPE ERROR   : name is STRING

NORMALIZE students.salary;            # SCHEMA ERROR : no such column

FILTER students WHERE marks > "good"; # TYPE ERROR   : INTEGER vs STRING

FILTER students WHERE department > "CSE";  # TYPE ERROR : ordering on STRING

FILL_NULL students.attendance WITH "unknown";   # TYPE ERROR : FLOAT <- STRING

NORMALIZE results.age;                # SEMANTIC ERROR: undefined dataset

SAVE students AS "out.csv";
