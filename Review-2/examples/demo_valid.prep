# ------------------------------------------------------------------
# demo_valid.prep -- the main demonstration program.
# Compiles cleanly: no lexical, syntax, semantic or type error, and
# every data contract holds against students.csv.
# ------------------------------------------------------------------

LOAD "students.csv" AS students;

EXPECT students.age NUMBER;
EXPECT students.department STRING;
EXPECT students.attendance BETWEEN 0 AND 100;

FILL_NULL students.attendance WITH 0;

DROP_NULL students;

NORMALIZE students.age;

FILTER students WHERE marks >= 50;

SELECT students [
    name,
    age,
    marks
];

SAVE students AS "cleaned_students.csv";
