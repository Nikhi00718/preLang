# The data contracts hold against the schema, but the DATA violates them.
#   students.csv row 6  : marks = 150   (outside 0..100)
#   students.csv row 7  : age   missing
#   students.csv row 9  : name  missing

LOAD "students.csv" AS students;

EXPECT students.age NUMBER;
EXPECT students.marks BETWEEN 0 AND 100;
EXPECT students.name NOT_NULL;
EXPECT students.attendance BETWEEN 0 AND 100;

SELECT students [ name, age, marks ];

SAVE students AS "checked.csv";
