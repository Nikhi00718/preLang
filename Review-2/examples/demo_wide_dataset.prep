# employees.csv has 30 columns but this pipeline needs only four.
# Review 3's optimiser uses this program to demonstrate column pruning.

LOAD "employees.csv" AS emp;

EXPECT emp.age NUMBER;
EXPECT emp.rating BETWEEN 1 AND 5;

DROP_NULL emp;
DROP_NULL emp;                        # redundant: eliminated by the optimiser

NORMALIZE emp.salary;

FILTER emp WHERE age > 21;

SELECT emp [ name, age, salary, department ];

SAVE emp AS "clean_employees.csv";
