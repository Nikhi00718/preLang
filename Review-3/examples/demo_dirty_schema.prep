# students_dirty.csv contains the value "abc" in the age column, so the
# schema analyser infers age : STRING.  Both statements below are then
# rejected at COMPILE time, before a single row is processed.

LOAD "students_dirty.csv" AS students;

EXPECT students.age NUMBER;           # contract violated by the schema itself

NORMALIZE students.age;               # TYPE ERROR: NORMALIZE needs a number

SAVE students AS "out.csv";
