# Exercises every production of the PrepLang grammar exactly once.

LOAD "employees.csv" AS emp;

EXPECT emp.age NUMBER;
EXPECT emp.name STRING;
EXPECT emp.active BOOLEAN;
EXPECT emp.rating BETWEEN 1 AND 5;
EXPECT emp.emp_id NOT_NULL;

DROP_NULL emp;
FILL_NULL emp.salary WITH 0;
FILL_NULL emp.department WITH "UNKNOWN";
NORMALIZE emp.salary;
FILTER emp WHERE age > 21;
DROP emp [ phone, email, pf_number ];
SELECT emp [ name, age, salary, department ];
SAVE emp AS "clean_employees.csv";
