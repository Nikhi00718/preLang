LOAD "Review-3/examples/students.csv" AS students;
EXPECT students.name STRING;
EXPECT students.age NUMBER;
EXPECT students.marks NUMBER;
EXPECT students.attendance BETWEEN 0 AND 100;
EXPECT students.department STRING;
FILL_NULL students.attendance WITH 0;
DROP_NULL students;
DROP_NULL students;
NORMALIZE students.age;
FILTER students WHERE marks >= 50;
SELECT students [ name, age, marks ];
SAVE students AS "Review-3/examples/cleaned_students.csv";
