# Every statement after LOAD has a semantic, type or contract error.
# The compiler finds all of them before any data is processed.
LOAD "students.csv" AS students;

NORMALIZE students.name;                      # type: name is STRING
FILTER students WHERE marks > "excellent";    # type: INTEGER compared with text
FILL_NULL students.age WITH "unknown";        # type: INTEGER column filled with text
NORMALIZE students.mark;                      # semantic: no column 'mark'
EXPECT students.department NOT_NULL;          # contract: department has an empty cell
EXPECT students.marks BETWEEN 0 AND 50;       # contract: marks go up to 95

DROP students [age];
FILTER students WHERE age > 20;               # semantic: age was dropped above
SAVE student AS "out.csv";                    # semantic: no dataset 'student'
